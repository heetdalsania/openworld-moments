{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenWorld Moments",
  "version": "0.0.0",
  "identifier": "org.openworldmoments.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenWorld Moments",
        "width": 1200,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: owm-media: http://owm-media.localhost; media-src owm-media: http://owm-media.localhost; connect-src ipc: http://ipc.localhost owm-media: http://owm-media.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
