{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/event-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "layout_key",
    "duration_ms",
    "offset",
    "total",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "session_id": {
      "$ref": "common.schema.json#/$defs/SessionId"
    },
    "layout_key": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "duration_ms": {
      "$ref": "common.schema.json#/$defs/TimelineMs"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["original", "effective", "revision", "status", "history", "history_truncated"],
        "properties": {
          "original": {
            "$ref": "event.schema.json"
          },
          "effective": {
            "$ref": "event.schema.json"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": ["current", "superseded", "stale", "legacy"]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["revision", "state", "type", "start_ms", "end_ms", "created_at"],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "state": {
                  "enum": ["unreviewed", "confirmed", "corrected", "rejected"]
                },
                "type": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
                  "maxLength": 128
                },
                "start_ms": {
                  "$ref": "common.schema.json#/$defs/TimelineMs"
                },
                "end_ms": {
                  "$ref": "common.schema.json#/$defs/TimelineMs"
                },
                "created_at": {
                  "$ref": "common.schema.json#/$defs/UtcTimestamp"
                }
              },
              "title": "EventDecision"
            },
            "maxItems": 20,
            "minItems": 0
          },
          "history_truncated": {
            "type": "boolean"
          }
        },
        "title": "EventReviewItem"
      },
      "maxItems": 100,
      "minItems": 0
    }
  },
  "title": "EventReview"
}
