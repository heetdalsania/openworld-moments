{
  "title": "ModelManager",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "models"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "models": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "title": "ManagedModel",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "revision",
          "size_bytes",
          "sha256",
          "license",
          "source_url",
          "downloaded_bytes",
          "disk_required_bytes",
          "active_sha256",
          "versions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "maxLength": 64
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 4294967296
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "const": "MIT"
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "downloaded_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "disk_required_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "active_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/model-manager.schema.json"
}
