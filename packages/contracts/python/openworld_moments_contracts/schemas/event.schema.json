{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/event.schema.json",
  "title": "Event",
  "description": "A time-ranged observation or suggestion about gameplay. Observations come from deterministic detectors or the user; suggestions come from models and stay suggestions until reviewed (spec 8.4.1, 8.4.6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session_id",
    "type",
    "start_ms",
    "end_ms",
    "confidence",
    "attributes",
    "evidence",
    "source",
    "review_state"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "id": { "$ref": "common.schema.json#/$defs/EventId" },
    "session_id": { "$ref": "common.schema.json#/$defs/SessionId" },
    "asset_id": { "$ref": "common.schema.json#/$defs/AssetId" },
    "type": {
      "description": "Namespaced dotted event type, e.g. 'openworld.wanted_level_changed'.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "start_ms": { "$ref": "common.schema.json#/$defs/TimelineMs" },
    "end_ms": { "$ref": "common.schema.json#/$defs/TimelineMs" },
    "confidence": { "$ref": "common.schema.json#/$defs/Confidence" },
    "attributes": {
      "description": "Event-type-specific values. Open map of scalars.",
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/ScalarValue" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "source": {
      "description": "Who produced the event. 'detector' and 'user' are observations; 'model' is a suggestion.",
      "oneOf": [
        { "$ref": "#/$defs/DetectorSource" },
        { "$ref": "#/$defs/ModelSource" },
        { "$ref": "#/$defs/UserSource" }
      ]
    },
    "review_state": {
      "type": "string",
      "enum": ["unreviewed", "confirmed", "corrected", "rejected"]
    }
  },
  "$defs": {
    "DetectorSource": {
      "title": "DetectorSource",
      "description": "Deterministic detector observation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detector_id", "detector_version"],
      "properties": {
        "kind": { "const": "detector" },
        "detector_id": { "$ref": "common.schema.json#/$defs/Slug" },
        "detector_version": { "$ref": "common.schema.json#/$defs/SemVer" },
        "profile_id": { "$ref": "common.schema.json#/$defs/Slug" },
        "profile_version": { "$ref": "common.schema.json#/$defs/SemVer" }
      }
    },
    "ModelSource": {
      "title": "ModelSource",
      "description": "Model suggestion. Must reference the sampled frames it is based on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model_id", "prompt_version", "sampled_frames_ms"],
      "properties": {
        "kind": { "const": "model" },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "prompt_version": { "$ref": "common.schema.json#/$defs/SemVer" },
        "sampled_frames_ms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/TimelineMs" }
        }
      }
    },
    "UserSource": {
      "title": "UserSource",
      "description": "Event created or marked manually by the user.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "user" }
      }
    }
  }
}
