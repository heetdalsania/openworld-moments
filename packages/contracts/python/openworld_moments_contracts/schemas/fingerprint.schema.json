{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/fingerprint.schema.json",
  "title": "AssetFingerprints",
  "description": "Identity and similarity fingerprints of one asset (spec 8.1.4, M06). 'sha256' is exact identity. 'fast_hash' screens for exact duplicates cheaply. 'frames' and 'audio' cover bounded head and tail windows for duplicate candidates and overlap alignment (M12). Every fingerprint names its algorithm and version; rows written by an older version are stale and recomputed by the 'fingerprint' backfill job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "sha256"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "asset_id": {
      "$ref": "common.schema.json#/$defs/AssetId"
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "fast_hash": {
      "$ref": "#/$defs/FastHash"
    },
    "frames": {
      "$ref": "#/$defs/FrameFingerprint"
    },
    "audio": {
      "$ref": "#/$defs/AudioFingerprint"
    }
  },
  "$defs": {
    "AlgorithmVersion": {
      "title": "AlgorithmVersion",
      "type": "integer",
      "minimum": 1
    },
    "FastHash": {
      "title": "FastHash",
      "description": "'owm-fast': SHA-256 over the file size (8 bytes, little-endian) and its first and last MiB. Equal values only suggest identical files; the full SHA-256 decides.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "version", "value", "computed_at"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["owm-fast"]
        },
        "version": {
          "$ref": "#/$defs/AlgorithmVersion"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$"
        },
        "computed_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      }
    },
    "FrameHash": {
      "title": "FrameHash",
      "description": "One sampled frame: its time in the asset and a 256-bit perceptual hash (64 lowercase hex digits). 'flat' marks a near-uniform frame (black, white, fades) that carries no identity and is ignored when comparing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t_ms", "hash"],
      "properties": {
        "t_ms": {
          "$ref": "common.schema.json#/$defs/TimelineMs"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "flat": {
          "type": "boolean"
        }
      }
    },
    "FrameFingerprint": {
      "title": "FrameFingerprint",
      "description": "'dhash256': difference hash of a 17x16 grayscale downscale, sampled at 'sample_fps' over the first and last 'window_ms' of the asset (the windows overlap for short assets).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "sample_fps",
        "window_ms",
        "head",
        "tail",
        "computed_at"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["dhash256"]
        },
        "version": {
          "$ref": "#/$defs/AlgorithmVersion"
        },
        "sample_fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "window_ms": {
          "type": "integer",
          "minimum": 1
        },
        "head": {
          "type": "array",
          "maxItems": 1800,
          "items": {
            "$ref": "#/$defs/FrameHash"
          }
        },
        "tail": {
          "type": "array",
          "maxItems": 1800,
          "items": {
            "$ref": "#/$defs/FrameHash"
          }
        },
        "computed_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      }
    },
    "AudioFingerprint": {
      "title": "AudioFingerprint",
      "description": "'energy-envelope': loudness of the first audio stream, mixed to mono at 8 kHz, as one value per 1/'rate_hz' seconds (0 = silence, 255 = full scale; 0.5 dB steps over a 127.5 dB range) over the same windows as the frame fingerprint. Compact enough for cross-correlation when refining overlaps. Absent when the asset has no audio.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "rate_hz",
        "window_ms",
        "head_start_ms",
        "head",
        "tail_start_ms",
        "tail",
        "computed_at"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["energy-envelope"]
        },
        "version": {
          "$ref": "#/$defs/AlgorithmVersion"
        },
        "rate_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "window_ms": {
          "type": "integer",
          "minimum": 1
        },
        "head_start_ms": {
          "$ref": "common.schema.json#/$defs/TimelineMs"
        },
        "head": {
          "type": "array",
          "maxItems": 3000,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "tail_start_ms": {
          "$ref": "common.schema.json#/$defs/TimelineMs"
        },
        "tail": {
          "type": "array",
          "maxItems": 3000,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "computed_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      }
    },
    "DuplicateCandidate": {
      "title": "DuplicateCandidate",
      "description": "Two distinct assets whose sampled frames look the same (same content in another file: a remux, a re-encode, a re-download). Only ever reported: nothing is merged or deleted. A person decides with 'review_state'; an automatic recomputation never overrides that decision.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_ids",
        "kind",
        "score",
        "evidence",
        "algorithm",
        "version",
        "review_state",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "asset_ids": {
          "description": "The two assets, in ascending order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "common.schema.json#/$defs/AssetId"
          }
        },
        "kind": {
          "type": "string",
          "enum": ["perceptual"]
        },
        "score": {
          "$ref": "common.schema.json#/$defs/Confidence"
        },
        "evidence": {
          "$ref": "#/$defs/DuplicateEvidence"
        },
        "algorithm": {
          "type": "string",
          "enum": ["perceptual-match"]
        },
        "version": {
          "$ref": "#/$defs/AlgorithmVersion"
        },
        "review_state": {
          "type": "string",
          "enum": ["unreviewed", "duplicate", "distinct"]
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      }
    },
    "DuplicateEvidence": {
      "title": "DuplicateEvidence",
      "description": "Why two assets are candidates: how many informative head/tail frame pairs were compared, how many matched (Hamming distance at most 'max_distance'), their mean distance, and the duration difference. 'audio_correlation' (-1..1) is added when both have audio; it informs review but does not decide.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compared_frames",
        "matching_frames",
        "mean_distance",
        "max_distance",
        "duration_delta_ms"
      ],
      "properties": {
        "compared_frames": {
          "type": "integer",
          "minimum": 0
        },
        "matching_frames": {
          "type": "integer",
          "minimum": 0
        },
        "mean_distance": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "max_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "duration_delta_ms": {
          "type": "integer",
          "minimum": 0
        },
        "audio_correlation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "FingerprintRequest": {
      "title": "FingerprintRequest",
      "description": "Parameters of a 'fingerprint' (backfill) job. Without 'asset_ids', every asset is considered. Without 'force', only missing or stale (older-version) fingerprints are computed, so a restarted job continues where it stopped.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/AssetId"
          }
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "FingerprintResult": {
      "title": "FingerprintResult",
      "description": "Result of a 'fingerprint' job.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "considered",
        "updated",
        "up_to_date",
        "unavailable",
        "failed",
        "new_candidates"
      ],
      "properties": {
        "considered": {
          "type": "integer",
          "minimum": 0
        },
        "updated": {
          "description": "Assets that got at least one new fingerprint.",
          "type": "integer",
          "minimum": 0
        },
        "up_to_date": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "description": "Assets whose bytes could not be read (missing source).",
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "description": "Assets whose fingerprinting failed (for example, undecodable frames).",
          "type": "integer",
          "minimum": 0
        },
        "new_candidates": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
