{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/diagnostics-report.schema.json",
  "title": "DiagnosticsReport",
  "description": "M31 support report. Never contains footage, file names, paths or tokens; failure messages only on opt-in, redacted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "worker",
    "system",
    "library",
    "models",
    "jobs",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/UtcTimestamp"
    },
    "host": {
      "description": "M33: the desktop host's platform report. Absent when the worker runs without a host.",
      "$ref": "platform-capabilities.schema.json"
    },
    "worker": {
      "title": "DiagnosticsWorker",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "schema_version", "worker_version"],
      "properties": {
        "api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "worker_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "system": {
      "title": "DiagnosticsSystem",
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "packaged": {
          "type": "boolean"
        },
        "platform": {
          "type": "string",
          "maxLength": 100
        },
        "architecture": {
          "type": "string",
          "maxLength": 100
        },
        "free_mib": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "title": "DiagnosticsCheck",
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "message"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "status": {
                "enum": ["pass", "warn", "fail"]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "title": "DiagnosticsTool",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "origin"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "origin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        }
      }
    },
    "library": {
      "title": "DiagnosticsLibrary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clips",
        "sessions",
        "projects",
        "renders",
        "watched_folders",
        "collections",
        "event_observations",
        "transcript_segments",
        "database_schema"
      ],
      "properties": {
        "clips": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "sessions": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "projects": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "renders": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "watched_folders": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "collections": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "event_observations": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "transcript_segments": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "database_schema": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "models": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "title": "DiagnosticsModel",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "revision", "installed"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "revision": {
            "type": "string",
            "maxLength": 100
          },
          "installed": {
            "type": "boolean"
          }
        }
      }
    },
    "jobs": {
      "title": "DiagnosticsJobs",
      "type": "object",
      "additionalProperties": false,
      "required": ["totals", "recent_failures"],
      "properties": {
        "totals": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "title": "DiagnosticsJobTotal",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "state", "count"],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "recent_failures": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "title": "DiagnosticsFailure",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "code", "retryable", "date"],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "retryable": {
                "type": "boolean"
              },
              "date": {
                "type": "string",
                "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|unknown)$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "privacy": {
      "title": "DiagnosticsPrivacy",
      "type": "object",
      "additionalProperties": false,
      "required": ["footage", "file_names", "paths", "tokens", "failure_messages"],
      "properties": {
        "footage": {
          "const": "never included"
        },
        "file_names": {
          "const": "removed"
        },
        "paths": {
          "const": "removed"
        },
        "tokens": {
          "const": "removed"
        },
        "failure_messages": {
          "enum": ["omitted", "included, redacted"]
        }
      }
    }
  }
}
