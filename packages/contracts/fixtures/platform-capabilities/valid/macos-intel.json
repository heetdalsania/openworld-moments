{
  "schema_version": "1.25",
  "host_version": "0.1.0",
  "os": {
    "family": "macos",
    "version": "15.2",
    "minimum": "14.0"
  },
  "architecture": {
    "binary": "x86_64",
    "translated": false
  },
  "build": {
    "target": "x86_64-apple-darwin",
    "profile": "release",
    "bundled_worker": true
  },
  "support": {
    "level": "development",
    "reasons": ["macos-preview"]
  },
  "directories": {
    "convention": "macos-standard"
  },
  "integrations": {
    "file_manager": "finder",
    "secret_store": "none",
    "menus": "default"
  }
}
