{
  "description": "Gatekeeper never accepts an ad hoc application",
  "expect": "semantic",
  "document": {
    "schema_version": "1.28",
    "host_version": "0.1.0",
    "os": {
      "family": "macos",
      "version": "15.2",
      "minimum": "14.0"
    },
    "architecture": {
      "binary": "aarch64",
      "translated": false
    },
    "build": {
      "target": "aarch64-apple-darwin",
      "profile": "release",
      "bundled_worker": true
    },
    "support": {
      "level": "development",
      "reasons": ["macos-preview"]
    },
    "directories": {
      "convention": "macos-standard"
    },
    "integrations": {
      "file_manager": "finder",
      "secret_store": "none",
      "menus": "native"
    },
    "signing": {
      "state": "adhoc",
      "hardened_runtime": true,
      "gatekeeper": "accepted"
    }
  },
  "message_contains": "ad hoc"
}
