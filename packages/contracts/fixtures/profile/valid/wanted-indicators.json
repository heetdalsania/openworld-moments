{
  "schema_version": "1.11",
  "id": "generic-wanted",
  "profile_version": "1.0.0",
  "display_name": "Analytic wanted indicators \u2014 synthetic only, game compatibility unvalidated",
  "game_family": "generic-open-world",
  "license": "Apache-2.0",
  "capabilities": ["frames.gray"],
  "frame": {
    "aspect_ratios": ["16:9"],
    "min_width": 640,
    "min_height": 360
  },
  "regions": {
    "wanted_indicator": [0.5, 0.05, 0.45, 0.16]
  },
  "detectors": [
    {
      "id": "wanted-indicators",
      "enabled": true,
      "min_confidence": 0.8,
      "confirmation_frames": 3,
      "wanted": {
        "max_level": 5,
        "shape": "star",
        "max_missing_frames": 1,
        "debounce_ms": 1500
      }
    }
  ],
  "safe_zones": {
    "preserve": ["wanted_indicator"]
  }
}
