{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/profile.schema.json",
  "title": "Profile",
  "description": "Game/resolution/HUD/locale profile (spec 8.4.5). Holds normalized regions and detector settings only, never game assets. May be authored as YAML; it is validated as JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile_version",
    "display_name",
    "game_family",
    "frame",
    "regions",
    "detectors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Slug"
    },
    "profile_version": {
      "$ref": "common.schema.json#/$defs/SemVer"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "game_family": {
      "$ref": "common.schema.json#/$defs/Slug"
    },
    "frame": {
      "title": "ProfileFrame",
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratios", "min_width", "min_height"],
      "properties": {
        "aspect_ratios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
          }
        },
        "min_width": {
          "type": "integer",
          "minimum": 1
        },
        "min_height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "regions": {
      "description": "Named normalized regions. Names are slugs.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Slug"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Region"
      }
    },
    "detectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DetectorSettings"
      }
    },
    "safe_zones": {
      "title": "SafeZones",
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve"],
      "properties": {
        "preserve": {
          "description": "Region names that vertical layouts must keep visible. Each must be defined in 'regions' (checked semantically).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Slug"
          }
        }
      }
    },
    "extends": {
      "$ref": "common.schema.json#/$defs/Slug"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["frames.gray", "audio.pcm"]
      }
    },
    "locales": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
      },
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/LocalePack"
      }
    }
  },
  "$defs": {
    "DetectorSettings": {
      "title": "DetectorSettings",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Slug"
        },
        "enabled": {
          "type": "boolean"
        },
        "min_confidence": {
          "$ref": "common.schema.json#/$defs/Confidence"
        },
        "confirmation_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "locale": {
          "description": "BCP 47 language tag, e.g. 'en' or 'pt-BR'.",
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
        },
        "wanted": {
          "$ref": "#/$defs/WantedSettings"
        },
        "ocr": {
          "$ref": "#/$defs/OcrSettings"
        }
      }
    },
    "LocalePack": {
      "title": "LocalePack",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "license", "vocabulary"],
      "properties": {
        "version": {
          "$ref": "common.schema.json#/$defs/SemVer"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "vocabulary": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Slug"
          },
          "maxProperties": 128,
          "additionalProperties": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "ocr_language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "description": "Installed Tesseract language ID; never a path or download URL."
        }
      }
    },
    "WantedSettings": {
      "title": "WantedSettings",
      "description": "Analytic indicator row and temporal tuning. Compatibility must be evaluated separately.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "shape": {
          "enum": ["star", "disc"]
        },
        "max_missing_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "debounce_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "OcrSettings": {
      "title": "OcrSettings",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preprocess": {
          "enum": ["contrast", "threshold"]
        },
        "min_text_confidence": {
          "$ref": "common.schema.json#/$defs/Confidence"
        },
        "match_threshold": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1
        },
        "max_missing_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    }
  }
}
