{
  "title": "StoryCandidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "generator",
    "input_key",
    "layout_key",
    "duration_ms",
    "offset",
    "total",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "session_id": {
      "$ref": "common.schema.json#/$defs/SessionId"
    },
    "generator": {
      "title": "StoryGenerator",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "const": "owm-story"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "input_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "layout_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "duration_ms": {
      "$ref": "common.schema.json#/$defs/TimelineMs"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "minItems": 0,
      "items": {
        "title": "StoryCandidateReview",
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "revision", "review_state", "current"],
        "properties": {
          "candidate": {
            "$ref": "story-candidate.schema.json"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "review_state": {
            "enum": ["suggested", "accepted", "rejected"]
          },
          "current": {
            "type": "boolean"
          },
          "project_id": {
            "$ref": "common.schema.json#/$defs/ProjectId"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/story-candidates.schema.json"
}
