{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/profile-patch.schema.json",
  "title": "ProfilePatch",
  "description": "Media-free local ROI overrides, separate from an installed profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "base_version",
    "base_key",
    "game_family",
    "frame",
    "regions",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "profile_id": {
      "$ref": "common.schema.json#/$defs/Slug"
    },
    "base_version": {
      "$ref": "common.schema.json#/$defs/SemVer"
    },
    "base_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "game_family": {
      "$ref": "common.schema.json#/$defs/Slug"
    },
    "frame": {
      "$ref": "profile.schema.json#/properties/frame"
    },
    "regions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Slug"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Region"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "created_at"],
      "properties": {
        "tool": {
          "const": "owm-calibration"
        },
        "version": {
          "const": "1"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      }
    }
  }
}
