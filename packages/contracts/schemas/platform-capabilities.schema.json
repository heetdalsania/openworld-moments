{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heetdalsania/openworld-moments/contracts/platform-capabilities.schema.json",
  "title": "PlatformCapabilities",
  "description": "What the desktop host knows about the computer and build it runs on (M33). Written by the host, never by the worker. Carries no paths, user names or hardware identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_version",
    "os",
    "architecture",
    "build",
    "support",
    "directories",
    "integrations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "host_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "os": {
      "title": "PlatformOs",
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "minimum"],
      "properties": {
        "family": {
          "enum": ["windows", "macos", "linux"]
        },
        "version": {
          "description": "Marketing version such as 15.2, or null when the host does not read it (Windows reports it in the system check).",
          "type": ["string", "null"],
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
        },
        "minimum": {
          "description": "Oldest release this build supports, or null when no floor is enforced.",
          "type": ["string", "null"],
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
        }
      }
    },
    "architecture": {
      "title": "PlatformArchitecture",
      "type": "object",
      "additionalProperties": false,
      "required": ["binary", "translated"],
      "properties": {
        "binary": {
          "description": "CPU architecture the host executable was built for.",
          "enum": ["x86_64", "aarch64"]
        },
        "translated": {
          "description": "True when the executable runs under translation (Rosetta 2); null when unknown.",
          "type": ["boolean", "null"]
        }
      }
    },
    "build": {
      "title": "PlatformBuild",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "profile", "bundled_worker"],
      "properties": {
        "target": {
          "description": "Rust target triple of the host.",
          "type": "string",
          "pattern": "^[a-z0-9_]+-[a-z0-9_]+-[a-z0-9_]+(-[a-z0-9_]+)?$",
          "maxLength": 100
        },
        "profile": {
          "enum": ["debug", "release"]
        },
        "bundled_worker": {
          "description": "Whether this build looks for a worker inside the application bundle.",
          "type": "boolean"
        }
      }
    },
    "support": {
      "title": "PlatformSupport",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {
          "description": "alpha: a supported alpha target; development: works but is not a supported release; unsupported: this build should not be used here.",
          "enum": ["alpha", "development", "unsupported"]
        },
        "reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "debug-build",
              "macos-preview",
              "linux-development",
              "os-below-minimum",
              "translated",
              "architecture-unsupported"
            ]
          }
        }
      }
    },
    "directories": {
      "title": "PlatformDirectories",
      "description": "Which convention application data follows. The paths themselves are never reported.",
      "type": "object",
      "additionalProperties": false,
      "required": ["convention"],
      "properties": {
        "convention": {
          "enum": ["windows-appdata", "macos-standard", "xdg"]
        }
      }
    },
    "integrations": {
      "title": "PlatformIntegrations",
      "type": "object",
      "additionalProperties": false,
      "required": ["file_manager", "secret_store", "menus"],
      "properties": {
        "file_manager": {
          "enum": ["explorer", "finder", "xdg-open"]
        },
        "secret_store": {
          "description": "Where persistent secrets would be kept. Nothing persists a secret yet.",
          "enum": ["none", "keychain", "credential-manager", "secret-service"]
        },
        "menus": {
          "enum": ["none", "default", "native"]
        }
      }
    }
  }
}
